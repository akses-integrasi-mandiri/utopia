# Install privately as ~/.config/aim-research/bridge.env (chmod 600).
# Bind a private address reachable from the Utopia container. Never expose via Traefik.
AIM_RESEARCH_BIND=127.0.0.1
AIM_RESEARCH_PORT=8796
AIM_RESEARCH_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
AIM_HERMES_COMMAND=/home/spark/.local/bin/hermes
# Optional explicit model; blank uses existing Hermes model/provider configuration.
AIM_HERMES_MODEL=
AIM_HERMES_TOOLSETS=web,browser
AIM_RESEARCH_TIMEOUT=600
